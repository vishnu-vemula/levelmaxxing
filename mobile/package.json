{
  "name": "@levelmaxing/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "validate:config": "expo config --type public",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/features/**/*.test.ts\"",
    "bundle": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@levelmaxing/contracts": "workspace:*",
    "@levelmaxing/design-tokens": "workspace:*",
    "expo": "57.0.34",
    "expo-constants": "~57.0.25",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "13.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0"
  }
}
