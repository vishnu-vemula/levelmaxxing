{
  "name": "@levelmaxing/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/metro.cjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/features/**/*.test.ts\"",
    "bundle": "node scripts/metro.cjs bundle --platform android --bundle-output dist/index.android.bundle --assets-dest dist/android-assets --dev false && node scripts/metro.cjs bundle --platform ios --bundle-output dist/index.ios.bundle --assets-dest dist/ios-assets --dev false"
  },
  "dependencies": {
    "@babel/runtime": "7.29.15",
    "@levelmaxing/contracts": "workspace:*",
    "@levelmaxing/design-tokens": "workspace:*",
    "firebase": "13.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "3.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.2.0",
    "metro": "0.87.3"
  }
}
