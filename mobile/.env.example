# Full API base, including /functions/v1/api for hosted Edge Functions.
APP_PUBLIC_API_URL=
# Public Firebase web app configuration from the project console.
APP_PUBLIC_FIREBASE_API_KEY=
APP_PUBLIC_FIREBASE_PROJECT_ID=
APP_PUBLIC_FIREBASE_APP_ID=
# Public ingress key for the Supabase Edge deployment. Firebase supplies user auth.
APP_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only for an explicit development build pointed at the loopback API.
APP_PUBLIC_ENABLE_LOCAL_AUTH=0
