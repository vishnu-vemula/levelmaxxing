# The deployed admin expects a same-origin reverse proxy at /api.
VITE_LEVELMAXING_API_BASE=/api

# Firebase Authentication is the default. Copy the Firebase web app's public config.
VITE_LEVELMAXING_AUTH_MODE=firebase
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# For the loopback harness, select local only while running Vite development.
# Paste the generated local operator credential into the sign-in screen.
