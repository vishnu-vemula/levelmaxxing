# The root dev:setup script generates local harness credentials under .local/.
# The Node entrypoint reads these settings for an owner-configured cloud connection.
LEVELMAXING_MODE=cloud
LEVELMAXING_PORT=4321
LEVELMAXING_ALLOWED_ORIGIN=
FIREBASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LEVELMAXING_CURSOR_SECRET=
